echo "💅 Running lint-staged (format + lint)..."
npx lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Linting failed. Commit aborted."
  exit 1
fi

echo "🧪 Running unit tests..."
npm run test:unit

if [ $? -ne 0 ]; then
  echo "❌ Unit tests failed. Commit aborted."
  exit 1
fi

echo "✅ All checks passed."
