# E2E tests only run when RUN_E2E=1 is set explicitly
# (requires test users in Supabase + TEST_BASE_URL configured)
if [ "$RUN_E2E" = "1" ]; then
  echo "🎭 Running E2E tests before push..."
  npm run test:e2e
  if [ $? -ne 0 ]; then
    echo "❌ E2E tests failed. Push aborted."
    exit 1
  fi
  echo "✅ E2E tests passed."
else
  echo "ℹ️  E2E tests skipped (set RUN_E2E=1 to enable)"
fi
